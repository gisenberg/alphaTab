{
    "name": "@coderline/alphatab",
    "version": "1.9.0",
    "description": "alphaTab is a music notation and guitar tablature rendering library",
    "keywords": [
        "guitar",
        "music-notation",
        "music-sheet",
        "html5",
        "svg",
        "guitar-tablature"
    ],
    "homepage": "https://alphatab.net",
    "bugs": {
        "url": "https://github.com/coderline/alphaTab/issues"
    },
    "author": "Daniel Kuschny",
    "license": "MPL-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/coderline/alphaTab.git"
    },
    "type": "module",
    "main": "dist/alphaTab.js",
    "module": "dist/alphaTab.mjs",
    "typings": "dist/alphaTab.d.ts",
    "exports": {
        ".": {
            "types": "./dist/alphaTab.d.ts",
            "import": "./dist/alphaTab.mjs",
            "require": "./dist/alphaTab.js"
        },
        "./webpack": {
            "types": "./dist/alphaTab.webpack.d.ts",
            "import": "./dist/alphaTab.webpack.mjs",
            "require": "./dist/alphaTab.webpack.js"
        },
        "./vite": {
            "types": "./dist/alphaTab.vite.d.ts",
            "import": "./dist/alphaTab.vite.mjs",
            "require": "./dist/alphaTab.vite.js"
        },
        "./model": {
            "types": "./dist/alphaTab.model.d.ts",
            "import": "./dist/alphaTab.model.mjs"
        },
        "./rendering": {
            "types": "./dist/alphaTab.rendering.d.ts",
            "import": "./dist/alphaTab.rendering.mjs"
        },
        "./player": {
            "types": "./dist/alphaTab.player.d.ts",
            "import": "./dist/alphaTab.player.mjs"
        },
        "./soundfont/*": "./dist/soundfont/*",
        "./font/*": "./dist/font/*"
    },
    "engines": {
        "node": ">=6.0.0"
    },
    "scripts": {
        "clean": "rimraf dist",
        "lint": "biome lint",
        "typecheck": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
        "prepack": "tsx scripts/prepack.mts",
        "bravura-smufl": "tsx scripts/smufl-metadata.ts font/bravura/bravura_metadata.json font/bravura/bravura_alphatab_metadata.json true",
        "generate-typescript": "rimraf src/generated && tsx scripts/generate-typescript.ts",
        "build": "npm run generate-typescript && vite build --mode esm && vite build --mode model && vite build --mode rendering && vite build --mode player && vite build --mode worker && vite build --mode worklet && vite build --mode umd",
        "test": "npm run test:unit && npm run test:performance",
        "test:unit": "vitest run --exclude test/visualTests/features/ColorPerformance.test.ts",
        "test:performance": "vitest run test/visualTests/features/ColorPerformance.test.ts --pool=forks --no-file-parallelism --maxWorkers=1",
        "bench:dsp": "node scripts/benchmark-dsp.mts",
        "bench:bounds": "tsx scripts/benchmark-bounds.mts",
        "test-web": "npm run test",
        "test-accept-reference": "tsx scripts/accept-new-reference-files.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@coderline/alphaskia": "^3.5.147",
        "@coderline/alphaskia-linux": "^3.5.147",
        "@coderline/alphaskia-windows": "^3.5.147",
        "@types/node": "^26.0.0",
        "rimraf": "^6.1.3",
        "tslib": "^2.8.1",
        "tsx": "^4.22.4",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "^8.1.0",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^4.1.10"
    },
    "files": [
        "/dist/alphaTab*.js",
        "/dist/alphaTab*.mjs",
        "/dist/alphaTab*.ts",
        "/dist/font/Bravura.*",
        "/dist/font/Bravura*.txt",
        "/dist/font/*.txt",
        "/dist/soundfont/*",
        "README.md",
        "LICENSE",
        "LICENSE.header"
    ]
}
